# Copy to .env and uncomment only what you need.
# A default Databasus install starts with none of these set.
# https://databasus.com/advanced-config/

# Public base URL. Used in invitation emails and as the default SMTP greeting name.
DATABASUS_URL=http://databasus.localhost.com
DATABASUS_PORT=4005
DATABASUS_DATA_PATH=/var/data/databasus/databasus_data


# Storage ownership. Leave unset unless the data mount is not writable as UID/GID 999.
# PUID=999
# PGID=999

# Set to true to disable anonymous usage telemetry.
# IS_DISABLE_ANONYMOUS_TELEMETRY=false

# --- Email (instance mail: invitations, password reset, sign-in codes) ---
# Mail turns on when SMTP_HOST is set. Needs HTTPS on a public domain for links.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Databasus <noreply@example.com>
# SMTP_HELO_NAME=
# SMTP_INSECURE_SKIP_VERIFY=false

# --- OAuth (redirect URL: https://<your-domain>/auth/callback) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Cloudflare Turnstile (both keys required to enable the challenge) ---
# CLOUDFLARE_TURNSTILE_SITE_KEY=
# CLOUDFLARE_TURNSTILE_SECRET_KEY=

# --- Logging ---
# LOG_LEVEL=info
# LOG_FILE_IS_ENABLED=true
# OPEN_TELEMETRY_URL=
# OPEN_TELEMETRY_HEADERS=

# Raw HTML/JS injected into every page. Only set a snippet you control.
# ANALYTICS_SCRIPT=
