server {
    listen 80; # or listen 443 ssl;
    server_name registry.yourdomain.com;

    client_max_body_size 0;

    location / {
        proxy_pass http://localhost:5000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Fix chunked upload timeout issues during heavy docker push
        proxy_read_timeout 900;
        proxy_send_timeout 900;
        
        # Required for Docker V2 API chunked uploads
        proxy_buffering off;
        proxy_request_buffering off;
    }
}

# Docker Registry Web UI (Port 443 -> 8083)
server {
    listen 80; # or listen 443 ssl;
    server_name ui.registry.yourdomain.com;

    location / {
        proxy_pass http://localhost:8083;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
