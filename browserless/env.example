SERVICE_NAME=browserless
BROWSERLESS_IMAGE=ghcr.io/browserless/chromium:v2.57.3
BROWSERLESS_PORT=3000

BROWSERLESS_DATA_PATH=/var/data/browserless/data
BROWSERLESS_DOWNLOADS_PATH=/var/data/browserless/downloads
BROWSERLESS_SCRATCH_PATH=/var/data/browserless/scratch
BROWSERLESS_METRICS_PATH=/var/data/browserless/metrics
BROWSERLESS_FONTS_PATH=./fonts

HOST=0.0.0.0
PORT=3000
EXTERNAL=http://browserless.localhost.com

# Required. Without it, every route including /function is unauthenticated.
TOKEN=ZvrsBcbxgzZOkZ-p_A8D5JRa8SIWhpuz
STRICT_TOKEN_USE=false

CONCURRENT=1
QUEUED=2
TIMEOUT=300000
RETRIES=2
HEARTBEAT_INTERVAL=30000

DATA_DIR=/data
DOWNLOAD_DIR=/downloads
SCRATCH_DIR=/scratch
METRICS_JSON_PATH=/metrics/metrics.json

CORS=false
CORS_ALLOW_ORIGIN="*"
CORS_ALLOW_METHODS="OPTIONS, POST, GET"
CORS_ALLOW_HEADERS="*"
CORS_ALLOW_CREDENTIALS=true
CORS_EXPOSE_HEADERS="*"
CORS_MAX_AGE=2592000
ALLOW_GET=false
ALLOW_FILE_PROTOCOL=false
DISABLE_BLOCKLIST=false
MAX_PAYLOAD_SIZE=10485760

HEALTH=true
MAX_CPU_PERCENT=100
MAX_MEMORY_PERCENT=75
MACHINE_STATS_SOURCE=cgroup
CPU_SAMPLE_INTERVAL_MS=1000
CPU_EMA_ALPHA=0.3
CPU_OVERLOAD_HYSTERESIS=10

DEBUG="-*"
LOG_LEVEL=info
LOG_FORMAT=plain
ENABLE_DEBUGGER=false
OTEL_ENABLED=false
