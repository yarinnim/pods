# Keycloak image and admin credentials
KEYCLOAK_IMAGE=keycloak/keycloak:26.6
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin@Secret1
KEYCLOAK_PORT=8080

# Postgres database for Keycloak
KEYCLOAK_DB_VENDOR=postgres
KEYCLOAK_DB_ADDR=common_postgresql
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USER=admin
KEYCLOAK_DB_PASSWORD=admin@Secret1

KEYCLOAK_HOSTNAME=http://127.0.0.1:8080

