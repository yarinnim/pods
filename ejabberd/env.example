EJABBERD_IMAGE=ghcr.io/processone/ejabberd:latest

# Admin Account Setup 
EJABBERD_DOMAIN=ejabberd.localhost.com
EJABBERD_ADMIN_USER=admin
EJABBERD_ADMIN_PASSWORD=admin@Secret1

# PostgreSQL backend (requires postgres stack on the backend network)
EJABBERD_DB_TYPE=pgsql
EJABBERD_DB_HOST=common_postgresql
EJABBERD_DB_PORT=5432
EJABBERD_DB_USERNAME=admin
EJABBERD_DB_PASSWORD=admin@Secret1
EJABBERD_DB_NAME=ejabberd_local

# Host Port Mappings (Standard mappings)
EJABBERD_CLIENT_TO_SERVER_PORT=5222
EJABBERD_SERVER_TO_SERVER_PORT=5269
EJABBERD_HTTP_PORT=5280
EJABBERD_HTTPS_PORT=5443

# Data persistence paths on the host
EJABBERD_DATABASE_PATH=/var/data/ejabberd/database
EJABBERD_LOGS_PATH=/var/data/ejabberd/logs
EJABBERD_CONF_PATH=/var/data/ejabberd/conf
EJABBERD_UPLOAD_PATH=/var/data/ejabberd/upload
